# ScanMark runtime
# ---------------------------------------------------------------------------
# ENVIRONMENT DECLARATION — read this before deploying anywhere.
#
# ScanMark treats a deployment as PRODUCTION unless it positively says it is
# not. An empty, missing or unrecognised value means production, and
# production refuses to boot without a real SECRET_KEY, PostgreSQL, Redis and
# a canonical public origin.
#
# Recognised non-production names: development, dev, local, test, testing, ci,
# debug. SCANMARK_ENV wins over FLASK_ENV if both are set.
#
# This is deliberate. The previous rule recognised only FLASK_ENV=production
# and RENDER=true, so the same image on any other host quietly ran with the
# public development secret, cookies without Secure, no HSTS and email
# verification switched off.
SCANMARK_ENV="development"
FLASK_ENV="development"
SECRET_KEY=""
DATABASE_URL="sqlite:///scanmark_v2.db"
REDIS_URL=""

# Shared mobile-carrier/campus IPs need room for a whole cohort. Tight signup
# limits apply to each normalized email, not to everyone behind that IP.
SIGNUP_EMAIL_RATE_LIMIT="5 per hour;20 per day"
AUTH_NETWORK_RATE_LIMIT="10000 per minute;100000 per day"
# Production must declare SCANMARK_ENV=production. TRUSTED_PROXY_COUNT defaults
# to 1 there; set the actual count of trusted proxies that rewrite forwarded
# headers (0 only for a directly exposed server). Never guess a larger count.

# The origin ScanMark believes it is served from, e.g.
# https://scanmark.funaab.edu.ng. Every link that leaves the process (email
# verification, password reset) is built from this rather than from the
# request's Host header — otherwise a request carrying `Host: evil.example`
# produces an emailed link on evil.example, handing over the signed token.
# Required in production. On Render, RENDER_EXTERNAL_HOSTNAME is used
# automatically if this is unset.
PUBLIC_ORIGIN=""
# Extra hostnames this deployment answers to, comma separated. Requests for
# any other host are refused with 421. PUBLIC_ORIGIN's host is always trusted.
TRUSTED_HOSTS=""

# Timezone everything is DISPLAYED in. Storage is always UTC; this is what
# turns a stored 23:30 UTC into the 00:30 next-day local time it actually was,
# and what "today" means when deciding which class sessions are today's.
SCANMARK_TIMEZONE="Africa/Lagos"

# Academic calendar. The month the academic year rolls over in, and the month
# the second semester starts. Courses are filed under a year and a semester so
# the same code can run again next term without colliding with this one.
ACADEMIC_YEAR_START_MONTH="9"
SECOND_SEMESTER_START_MONTH="2"

# Deliberate escape hatches for the production startup checks. Each one turns
# a refusal to boot back into a warning. Set them only when you mean it.
ALLOW_SQLITE_IN_PRODUCTION="false"
ALLOW_MISSING_REDIS="false"
ALLOW_HOST_HEADER_URLS="false"

# CampOS integration
# Public origin of CampOS Core. Production must use HTTPS.
CAMPOS_CORE_URL="http://localhost:3000"
# Tenant lock: use the institution slug registered in CampOS. Production
# refuses SSO when neither this nor CAMPOS_INSTITUTION_ID is configured.
CAMPOS_INSTITUTION_SLUG="demo-university"
CAMPOS_INSTITUTION_ID=""
# Required in every environment. Set this to the exact same value as CampOS
# Core's SSO_JWT_SECRET_SCANMARK, including for local SSO development. Do not
# reuse either application's normal login/session secret. SSO_JWT_SECRET is
# accepted only as a legacy rollout fallback.
CAMPOS_SSO_SECRET=""
# Institution-scoped ScanMark key issued by CampOS with write:attendance.
CAMPOS_API_KEY=""

# Which universities can sign up
# Empty (the default) accepts any address under an academic suffix below, so a
# lecturer at another university can register without a config change.
# Set it to lock this deployment to named institutions, comma separated:
#   INSTITUTION_DOMAINS="funaab.edu.ng,unilag.edu.ng"
# That also restores exact-institution matching, which is what keeps a
# lookalike domain (evilfunaab.edu.ng) out — with no allowlist a lookalike is
# simply a different institution.
INSTITUTION_DOMAINS=""
# What counts as academic when no allowlist is set. These second-level domains
# are registry-restricted to accredited institutions.
ACADEMIC_DOMAIN_SUFFIXES="edu.ng,edu,ac.ng,ac.uk,ac.za,edu.gh,ac.ke,edu.au,ac.in"
# The subdomain that marks a staff mailbox: lecturer@staff.<institution>.
# Everyone else at an institution signs up as a student.
STAFF_SUBDOMAIN="staff"
# Accepted, but only ever as a student.
PERSONAL_EMAIL_DOMAINS="gmail.com"

# Account security
# Self-service STUDENT signups must click an emailed link before their password
# works. Lecturers and Course Coordinators are not gated: their account works as
# soon as it is created (they still get the link, nothing waits on it).
# Defaults to on in production, off elsewhere. Do not turn it off in
# production: the signup form accepts any address, so the link is all that
# stops a stranger registering in a student's name.
REQUIRE_EMAIL_VERIFICATION=""
MIN_PASSWORD_LENGTH="10"

# Attendance
# DEFAULT max metres between the pinned class location and a scanning student.
# Phone GPS indoors is often 20-50m off, so do not set this too tight.
#
# A saved classroom can override this per room (the "Threshold" field on
# /classrooms), because one number cannot fit a seminar room and a 400-seat
# theatre alike. This is the fallback for rooms that do not set one, and for
# an ad-hoc browser pin.
GEOFENCE_RADIUS_M="100"
# What happens when a lecturer never pins a classroom location. DEFAULTS TRUE:
# with no pin there is nothing to measure against, so the scan is refused.
# Off, the failure is silent and total — a lecturer who dismissed one browser
# location prompt records a whole term of attendance that anyone could have
# submitted from anywhere, and nothing on the register says so.
GEOFENCE_REQUIRED="true"
# Reported GPS accuracy beyond which a fix proves nothing. A reading is
# refused rather than used to widen the fence: accuracy is self-reported, so
# treating it as an allowance would be a free pass for the asking. Defaults to
# GEOFENCE_RADIUS_M.
GEOFENCE_MAX_ACCURACY_M=""
# Oldest position fix a scan may carry, in milliseconds. Phones will happily
# hand back a cached fix from hours ago and somewhere else entirely.
GEOFENCE_MAX_LOCATION_AGE_MS="30000"
# Worst accuracy a CLASSROOM PIN may report. The pin is the CENTRE of the
# fence, so its error is added to every student's: a pin 36km out refuses the
# whole room, and tells the students it is their fault. Lecturers project from
# laptops, which have no GPS and locate themselves from Wi-Fi or their IP
# address — that is what this catches. Defaults to GEOFENCE_RADIUS_M.
#
# Refusing such a pin is only safe because there is somewhere else for the
# coordinates to come from: Classrooms, saved once per lecture hall under
# /classrooms and picked from a dropdown when a class starts.
GEOFENCE_MAX_PIN_ACCURACY_M=""
# Attendance percentage shown as the target on student dashboards. Nothing
# is sent when a student falls below it.
ATTENDANCE_TARGET_PERCENT="75"
# Seconds the projector shows one code before rotating.
QR_TOKEN_TTL="12"
# How stale a scanned token may be when the request is PROCESSED. Keep it well
# above your p99 scan latency or queued scans bounce as expired under load.
# It is also the outer bound on the replay window for a photographed code —
# narrowed in practice by three other things: the session must still be open
# (ending a class kills every token for it immediately), the client's reported
# capture time must fall inside QR_CAPTURE_WINDOW of the token, and the
# geofence must be satisfied.
QR_CODE_WINDOW="45"
# How far the client's reported capture time may sit from the token's own
# timestamp. Judges a queued offline scan on when the camera actually read the
# screen rather than on when the phone regained signal. Defaults to
# QR_CODE_WINDOW.
QR_CAPTURE_WINDOW=""

# Names rendered inline per class session on the attendance page. The full
# sheet is a page of its own — ten sessions of a 2000-student course is 20,000
# rows in one document otherwise.
ATTENDANCE_PREVIEW_ROWS="25"

# CampOS SSO callbacks must carry a state value this browser was issued, so a
# hand-off code cannot be fed to somebody else's browser to sign it into the
# attacker's account. Turn off ONLY for a CampOS that predates state support.
CAMPOS_SSO_REQUIRE_STATE="true"

# Capacity
# Anonymous requests are keyed by IP and a campus NAT is one IP for thousands
# of phones, so the shared default has to be generous. Sensitive unauthenticated
# endpoints carry their own tight per-address limits on top of this.
ANON_RATE_LIMIT_PER_MINUTE="20000"
ANON_RATE_LIMIT_PER_DAY="500000"
# ScanMark sends email at signup and password reset only — nothing during a
# class. This pool carries just those, so it is small on purpose.
BACKGROUND_QUEUE_MAXSIZE="500"
BACKGROUND_WORKERS="4"
# Fraction of SUCCESSFUL scans that get a timing line in the log. Every
# non-success outcome always logs.
SCAN_LOG_SAMPLE_RATE="0.02"

# Optional providers used elsewhere in ScanMark
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Mail. ScanMark sends two things: the signup confirmation link and password
# resets. Check the settings actually work with `python mail_selftest.py`,
# which connects for real and names the reason when it cannot.
#
# How mail leaves: "smtp" or "brevo". Left unset it is brevo when
# BREVO_API_KEY is set, otherwise smtp. Hosts that block outbound SMTP —
# Render's free instances among them — cannot use smtp at all: the connection
# fails with "Network is unreachable" before any SMTP is spoken, no matter how
# correct the credentials are. Brevo goes over HTTPS on 443 instead.
MAIL_PROVIDER=""

# --- Brevo (HTTP API) ---
# The v3 key from Settings → SMTP & API → API Keys. The sender address below
# must be verified under Senders, Domains & Dedicated IPs first.
BREVO_API_KEY=""

# --- SMTP ---
MAIL_SERVER="smtp.gmail.com"
# 587 = STARTTLS, 465 = implicit SSL. TLS mode follows the port unless
# MAIL_USE_TLS / MAIL_USE_SSL says otherwise.
MAIL_PORT="587"
MAIL_USERNAME=""
# Gmail: a 16-character App Password (2-Step Verification must be on). The
# account password has not been accepted since 2022. Google shows the app
# password in groups of four — the spaces are display only and are stripped.
MAIL_PASSWORD=""
# Used by both providers. Defaults to MAIL_USERNAME. A display name is fine:
# "ScanMark <you@example.com>". Providers refuse a sender they have not
# verified — the Gmail mailbox you authenticate as, or the address verified in
# the Brevo dashboard.
MAIL_DEFAULT_SENDER=""
# Seconds to wait on the mail server. Without a bound, a host that filters
# outbound SMTP hangs a worker on connect instead of failing.
MAIL_TIMEOUT="15"
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Capacity
# ---------------------------------------------------------------------------
# Scans per second per session that admission control admits to the database.
# A token bucket in Redis smooths the burst a projected QR code creates.
# 0 = off, and it ships off on purpose: the right value is the rate YOUR
# database plan is measured to sustain, and a default here would be a guess
# with the authority of a measured number. See loadtest/README.md.
SCAN_ADMISSION_RATE="0"
# Instantaneous burst allowed through before shaping starts. Defaults to one
# second of SCAN_ADMISSION_RATE.
SCAN_ADMISSION_BURST=""
# Retry-After on a shed scan. Sub-second: this smooths microbursts, it does
# not queue attendance.
SCAN_ADMISSION_RETRY_SECONDS="0.5"

# Per-stage response budget, in milliseconds. Breaches are counted per stage
# so a rehearsal says WHICH component is slow. Calibrate from staging.
BUDGET_QR_VERIFY_MS="1"
BUDGET_SESSION_COURSE_MS="10"
BUDGET_ENROLLMENT_MS="10"
BUDGET_ADMISSION_MS="5"
BUDGET_GEOFENCE_MS="5"
BUDGET_DB_INSERT_MS="20"
BUDGET_ENQUEUE_MS="5"
BUDGET_SCAN_TOTAL_MS="100"

# Seconds the lecturer's headcount is cached. The ONLY bound on how stale the
# live counter is: nothing invalidates it per scan, because doing so put a
# Redis round trip inside every one of 2,000 requests.
ATTENDEE_SUMMARY_TTL="2"
# Rows the live projector screen keeps in the DOM.
PROJECTOR_RECENT_ROWS="50"

# Redis connection pool. Left implicit, every gunicorn thread opens
# connections on demand with no ceiling.
REDIS_MAX_CONNECTIONS=""
REDIS_CONNECT_TIMEOUT="2"
REDIS_SOCKET_TIMEOUT="2"
REDIS_HEALTH_CHECK_INTERVAL="30"

# Retry-After when the database connection pool is exhausted (503, not 500).
DB_SATURATION_RETRY_SECONDS="2"
# How long a pinned classroom lives. Keyed per session, so it dies with the
# meeting rather than geofencing the next class against the last room used.
CLASS_LOCATION_TTL="14400"
# A scan must report when its camera read the code. Turn off only while
# offline scans queued by a pre-release service worker are still draining.
REQUIRE_CAPTURED_AT="true"
