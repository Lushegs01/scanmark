# ScanMark runtime
# ---------------------------------------------------------------------------
# ENVIRONMENT DECLARATION — read this before deploying anywhere.
#
# ScanMark treats a deployment as PRODUCTION unless it positively says it is
# not. An empty, missing or unrecognised value means production, and
# production refuses to boot without a real SECRET_KEY, PostgreSQL, Redis and
# a canonical public origin.
#
# Recognised non-production names: development, dev, local, test, testing, ci,
# debug. SCANMARK_ENV wins over FLASK_ENV if both are set.
#
# This is deliberate. The previous rule recognised only FLASK_ENV=production
# and RENDER=true, so the same image on any other host quietly ran with the
# public development secret, cookies without Secure, no HSTS and email
# verification switched off.
SCANMARK_ENV="development"
FLASK_ENV="development"
SECRET_KEY=""
DATABASE_URL="sqlite:///scanmark_v2.db"
REDIS_URL=""

# The origin ScanMark believes it is served from, e.g.
# https://scanmark.funaab.edu.ng. Every link that leaves the process (email
# verification, password reset) is built from this rather than from the
# request's Host header — otherwise a request carrying `Host: evil.example`
# produces an emailed link on evil.example, handing over the signed token.
# Required in production. On Render, RENDER_EXTERNAL_HOSTNAME is used
# automatically if this is unset.
PUBLIC_ORIGIN=""
# Extra hostnames this deployment answers to, comma separated. Requests for
# any other host are refused with 421. PUBLIC_ORIGIN's host is always trusted.
TRUSTED_HOSTS=""

# Timezone everything is DISPLAYED in. Storage is always UTC; this is what
# turns a stored 23:30 UTC into the 00:30 next-day local time it actually was,
# and what "today" means when deciding which class sessions are today's.
SCANMARK_TIMEZONE="Africa/Lagos"

# Academic calendar. The month the academic year rolls over in, and the month
# the second semester starts. Courses are filed under a year and a semester so
# the same code can run again next term without colliding with this one.
ACADEMIC_YEAR_START_MONTH="9"
SECOND_SEMESTER_START_MONTH="2"

# Deliberate escape hatches for the production startup checks. Each one turns
# a refusal to boot back into a warning. Set them only when you mean it.
ALLOW_SQLITE_IN_PRODUCTION="false"
ALLOW_MISSING_REDIS="false"
ALLOW_HOST_HEADER_URLS="false"

# CampOS integration
# Public origin of CampOS Core. Production must use HTTPS.
CAMPOS_CORE_URL="http://localhost:3000"
# Tenant lock: use the institution slug registered in CampOS. Production
# refuses SSO when neither this nor CAMPOS_INSTITUTION_ID is configured.
CAMPOS_INSTITUTION_SLUG="demo-university"
CAMPOS_INSTITUTION_ID=""
# Required in every environment. Set this to the exact same value as CampOS
# Core's SSO_JWT_SECRET_SCANMARK, including for local SSO development. Do not
# reuse either application's normal login/session secret. SSO_JWT_SECRET is
# accepted only as a legacy rollout fallback.
CAMPOS_SSO_SECRET=""
# Institution-scoped ScanMark key issued by CampOS with write:attendance.
CAMPOS_API_KEY=""

# Account security
# Self-service signups must click an emailed link before their password works.
# Defaults to on in production, off elsewhere. Do not turn it off in
# production: the signup form accepts any address, including a @staff one the
# registrant does not own.
REQUIRE_EMAIL_VERIFICATION=""
MIN_PASSWORD_LENGTH="10"

# Attendance
# Max metres between the pinned class location and a scanning student. Phone
# GPS indoors is often 20-50m off, so do not set this too tight.
GEOFENCE_RADIUS_M="100"
# What happens when a lecturer never pins a classroom location. DEFAULTS TRUE:
# with no pin there is nothing to measure against, so the scan is refused.
# Off, the failure is silent and total — a lecturer who dismissed one browser
# location prompt records a whole term of attendance that anyone could have
# submitted from anywhere, and nothing on the register says so.
GEOFENCE_REQUIRED="true"
# Reported GPS accuracy beyond which a fix proves nothing. A reading is
# refused rather than used to widen the fence: accuracy is self-reported, so
# treating it as an allowance would be a free pass for the asking. Defaults to
# GEOFENCE_RADIUS_M.
GEOFENCE_MAX_ACCURACY_M=""
# Oldest position fix a scan may carry, in milliseconds. Phones will happily
# hand back a cached fix from hours ago and somewhere else entirely.
GEOFENCE_MAX_LOCATION_AGE_MS="30000"
# Attendance percentage shown as the target on student dashboards. Nothing
# is sent when a student falls below it.
ATTENDANCE_TARGET_PERCENT="75"
# Seconds the projector shows one code before rotating.
QR_TOKEN_TTL="12"
# How stale a scanned token may be when the request is PROCESSED. Keep it well
# above your p99 scan latency or queued scans bounce as expired under load.
# It is also the outer bound on the replay window for a photographed code —
# narrowed in practice by three other things: the session must still be open
# (ending a class kills every token for it immediately), the client's reported
# capture time must fall inside QR_CAPTURE_WINDOW of the token, and the
# geofence must be satisfied.
QR_CODE_WINDOW="45"
# How far the client's reported capture time may sit from the token's own
# timestamp. Judges a queued offline scan on when the camera actually read the
# screen rather than on when the phone regained signal. Defaults to
# QR_CODE_WINDOW.
QR_CAPTURE_WINDOW=""

# Names rendered inline per class session on the attendance page. The full
# sheet is a page of its own — ten sessions of a 2000-student course is 20,000
# rows in one document otherwise.
ATTENDANCE_PREVIEW_ROWS="25"

# CampOS SSO callbacks must carry a state value this browser was issued, so a
# hand-off code cannot be fed to somebody else's browser to sign it into the
# attacker's account. Turn off ONLY for a CampOS that predates state support.
CAMPOS_SSO_REQUIRE_STATE="true"

# Capacity
# Anonymous requests are keyed by IP and a campus NAT is one IP for thousands
# of phones, so the shared default has to be generous. Sensitive unauthenticated
# endpoints carry their own tight per-address limits on top of this.
ANON_RATE_LIMIT_PER_MINUTE="20000"
ANON_RATE_LIMIT_PER_DAY="500000"
# ScanMark sends email at signup and password reset only — nothing during a
# class. This pool carries just those, so it is small on purpose.
BACKGROUND_QUEUE_MAXSIZE="500"
BACKGROUND_WORKERS="4"
# Fraction of SUCCESSFUL scans that get a timing line in the log. Every
# non-success outcome always logs.
SCAN_LOG_SAMPLE_RATE="0.02"

# Optional providers used elsewhere in ScanMark
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
SENTRY_DSN=""
